{
	"name": "n8n-nodes-webscraping-ai",
	"version": "1.4.0",
	"description": "n8n node to call WebScraping.AI API services - LLM-powered web scraping with JavaScript rendering and proxies.",
	"keywords": [
		"n8n-community-node-package",
		"web scraping",
		"webscraping.ai",
		"ai scraping",
		"llm",
		"data extraction"
	],
	"license": "MIT",
	"homepage": "https://webscraping.ai",
	"author": {
		"name": "WebScraping.AI",
		"email": "support@webscraping.ai"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/webscraping-ai/webscraping-ai-n8n.git"
	},
	"engines": {
		"node": ">=20.15"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"format": "prettier nodes credentials test scripts --write",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"test": "jest",
		"smoke": "rimraf .smoke && tsc -p tsconfig.smoke.json && node .smoke/scripts/smoke.js",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/WebScrapingAiApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/WebScrapingAi/WebScrapingAi.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "^0.54.3",
		"@types/jest": "^29.5.14",
		"@types/node": "^24.0.13",
		"eslint": "^9.32.0",
		"jest": "^29.7.0",
		"n8n-workflow": "^2.46.0",
		"prettier": "^3.6.2",
		"rimraf": "^6.0.1",
		"ts-jest": "^29.4.9",
		"typescript": "^5.9.2"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
